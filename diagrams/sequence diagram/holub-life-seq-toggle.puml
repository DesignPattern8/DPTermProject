@startuml holub-life-seq-toggle
' SD2. 셀 상태 토글 (UC1)
' 근거: Universe.java (MouseAdapter), Neighborhood.userClicked(), Resident.userClicked()
skinparam defaultFontName "Noto Sans CJK KR"
skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 260
skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #444444
  LifeLineBorderColor #999999
  ArrowColor #444444
  GroupBackgroundColor #F2F2F2
}
skinparam note {
  BackgroundColor #FFFBE6
  BorderColor #C9B458
}
autonumber "<b>0."

title SD2. 셀 상태 토글 — 마우스 클릭 → 좌표 변환(재귀) → 토글 → 다시 그리기

actor "사용자" as User
participant "Swing EDT" as EDT
participant ":Universe\n<<Singleton, Mediator>>" as U
participant "outermost\n:Neighborhood" as ON
participant "inner\n:Neighborhood" as IN
participant ":Resident" as R

User -> EDT : 그리드 클릭
EDT -> U : mousePressed(e)  (익명 MouseAdapter)
activate U
U -> U : bounds = getBounds()\nbounds.x = bounds.y = 0
U -> ON : userClicked(e.getPoint(), bounds)
activate ON
ON -> ON : pixelsPerCell = width / gridSize\nrow = y / pixelsPerCell, column = x / pixelsPerCell\n나머지(offset)로 하위 좌표 계산
ON -> IN : grid[row][column].userClicked(offset, subcell)
activate IN
IN -> IN : 같은 방식으로 row, column, offset 계산
IN -> R : grid[row][column].userClicked(offset, subcell)
activate R
R -> R : amAlive = !amAlive
deactivate R
IN -> IN : amActive = true\nrememberThatCellAtEdgeChangedState(row, column)
note right of IN : 경계 칸이면 activeEdges에\nNORTH/WEST 등을 추가 →\n다음 tick에 이웃 블록도 계산
deactivate IN
ON -> ON : amActive = true\nrememberThatCellAtEdgeChangedState(row, column)
deactivate ON
U -> U : repaint()
deactivate U

U ->> EDT : 다시 그리기 요청 (RepaintManager)
EDT -> U : paint(g)
activate U
U -> ON : redraw(g, panelBounds, drawAll = true)
activate ON
loop 8×8 하위 셀
  ON -> IN : redraw(g, subcell, true)
  activate IN
  loop 8×8 Resident
    IN -> R : redraw(g, subcell, true)
    R -> R : 살아있으면 LIVE_COLOR(빨강)\n아니면 DEAD_COLOR로 칠함
  end
  IN -> IN : 블록 테두리(주황), active면 파랑 테두리
  deactivate IN
end
deactivate ON
deactivate U

@enduml
