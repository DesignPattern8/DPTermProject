@startuml
skinparam classAttributeIconSize 0
left to right direction
package "com.holub.life (e38ce7a)" {
 class Life
 class Universe {
  doLoad()
  doStore()
  paint()
  refreshNow()
 }
 class Clock {
  startTicking()
  tick()
  createMenus()
  menuIsActive()
 }
