@startuml board-api-before
title 공통 보드 API 도입 전
skinparam classAttributeIconSize 0
hide empty members
left to right direction

package "model (A)" {
  interface Cell <<Component>> {
    +figureNextState(...) : boolean
    +transition() : boolean
    +toggle(row : int, column : int) : void
    +clear() : void
    +createMemento() : NeighborhoodState
    +transfer(...) : boolean
  }
  class Neighborhood <<Composite>>
  class Resident <<Leaf>>
  class NeighborhoodState

  Neighborhood ..|> Cell
  Resident ..|> Cell
  Neighborhood *-- Cell : grid
  Cell ..> NeighborhoodState : createMemento()
}

package "application (B)" {
  class GameController {
    +tick() : boolean
  }
}
package "persistence (C)" {
  class LegacyLifeCodec
}
package "ui (D)" {
  class BoardRenderer
}

GameController --> Cell : outermostCell
LegacyLifeCodec ..> NeighborhoodState : 파일 변환
BoardRenderer ..> Cell : 렌더링
BoardRenderer ..> Neighborhood : 하위 셀과 활성 정보
@enduml
